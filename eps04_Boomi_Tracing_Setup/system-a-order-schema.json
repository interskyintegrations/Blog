{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intersky.nl/schemas/system-a-order.schema.json",
  "title": "System A Order",
  "description": "Order message created by System A. The orderId is the business key and correlationId is propagated for functional tracing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "orderId",
    "correlationId",
    "orderDate",
    "orderStatus",
    "customer",
    "currency",
    "orderLines",
    "shippingAddress",
    "sourceSystem"
  ],
  "properties": {
    "orderId": {
      "type": "string",
      "pattern": "^SO-[0-9]+$",
      "description": "Business key used for functional tracing.",
      "examples": ["SO-1042"]
    },
    "correlationId": {
      "type": "string",
      "format": "uuid",
      "description": "End-to-end technical trace identifier.",
      "examples": ["7db2f7c8-ef5b-4afc-8c56-1a4df2e5042c"]
    },
    "orderDate": {
      "type": "string",
      "format": "date-time",
      "examples": ["2026-08-15T09:41:03Z"]
    },
    "orderStatus": {
      "type": "string",
      "enum": ["CONFIRMED", "CANCELLED"],
      "examples": ["CONFIRMED"]
    },
    "customer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["customerId", "name"],
      "properties": {
        "customerId": { "type": "string", "examples": ["CUST-2048"] },
        "name": { "type": "string", "examples": ["Northwind Retail"] }
      }
    },
    "currency": {
      "type": "string",
      "enum": ["EUR"],
      "examples": ["EUR"]
    },
    "orderLines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lineNumber", "itemCode", "description", "quantity", "unitPrice"],
        "properties": {
          "lineNumber": { "type": "integer", "minimum": 1, "examples": [1] },
          "itemCode": { "type": "string", "examples": ["WIDGET-BLUE-01"] },
          "description": { "type": "string", "examples": ["Blue Widget"] },
          "quantity": { "type": "integer", "minimum": 1, "examples": [2] },
          "unitPrice": { "type": "number", "minimum": 0, "examples": [49.95] }
        }
      }
    },
    "shippingAddress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["countryCode", "city"],
      "properties": {
        "countryCode": { "type": "string", "pattern": "^[A-Z]{2}$", "examples": ["NL"] },
        "city": { "type": "string", "examples": ["Amsterdam"] }
      }
    }
  },
  "examples": [
    {
      "orderId": "SO-1042",
      "correlationId": "7db2f7c8-ef5b-4afc-8c56-1a4df2e5042c",
      "orderDate": "2026-08-15T09:41:03Z",
      "orderStatus": "CONFIRMED",
      "customer": { "customerId": "CUST-2048", "name": "Northwind Retail" },
      "currency": "EUR",
      "orderLines": [
        { "lineNumber": 1, "itemCode": "WIDGET-BLUE-01", "description": "Blue Widget", "quantity": 2, "unitPrice": 49.95 },
        { "lineNumber": 2, "itemCode": "CABLE-USB-C-02", "description": "USB-C Cable", "quantity": 1, "unitPrice": 19.95 }
      ],
      "shippingAddress": { "countryCode": "NL", "city": "Amsterdam" }
    }
  ]
}
